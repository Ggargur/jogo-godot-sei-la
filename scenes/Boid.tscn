[sub_resource type="GDScript" id="GDScript_3wvxu"]
script/source = "extends RigidBody2D

class_name Boid

const max_force = 2400.0
const max_speed = 400
const perception_radius = 150

const alignment_mult = 0.5
const cohesion_mult = 0.5
const separation_mult = 0.5

var acceleration = Vector2()

func random_vector(max_X: float, max_Y:float) -> Vector2:
	return Vector2(randf() * max_X, randf() * max_Y)

func get_boids(resultado: Array[Boid] = []) -> Array[Boid]:
	var boids = get_tree().get_nodes_in_group(\"boids\")
	for filho in boids:
		if filho is Boid:
			resultado.append(filho)
	return resultado

func _ready() -> void:
	var window_size = get_viewport_rect().size
	position = random_vector(window_size.x, window_size.y)
	linear_velocity = Vector2.from_angle(randf() * TAU) * max_speed
	add_to_group(\"boids\")
	
func fix_steering(steering: Vector2) -> Vector2:
	steering = steering.normalized() * max_speed
	steering -= self.linear_velocity
	return steering.limit_length(max_force)
	
func align(boids: Array[Boid]) -> Vector2:
	var steering: Vector2 = Vector2()
	for boid in boids:
		steering += boid.linear_velocity
			
	return fix_steering(steering)


func cohesion(boids: Array[Boid]) -> Vector2:
	var steering = Vector2()
	for boid in boids:
		steering += boid.position
	
	steering /= boids.size()
	steering -= position
	return fix_steering(steering)
	
func separation(boids: Array[Boid]) -> Vector2:
	var steering = Vector2()
	for boid in boids:
		var diff = position - boid.position
		var dist = diff.length()
		if dist > 0.0:
			steering += diff / (dist * dist)
	
	return fix_steering(steering)


func flock(boids = get_boids()) -> void:
		acceleration = Vector2()
		var close_boids: Array[Boid] = boids.filter(func(boid): return boid != self && position.distance_squared_to(boid.position) <= perception_radius * perception_radius)
		
		if close_boids.size() > 0 :
			var a = align(close_boids) * alignment_mult
			var c = cohesion(close_boids) * cohesion_mult
			var s = separation(close_boids) * separation_mult
			
			acceleration = a + c + s	

func _integrate_forces(state: PhysicsDirectBodyState2D) -> void:
	state.linear_velocity += acceleration * state.step
	state.linear_velocity = state.linear_velocity.limit_length(max_speed)

func _physics_process(_delta: float) -> void:
	flock()
"

